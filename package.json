{
  "name": "lens-translate",
  "version": "0.1.0",
  "description": "Context-aware screen translation for Windows",
  "author": "Lens Translate",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/services.cjs && node --check src/preload.cjs && node --check src/ui/app.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "openai": "^6.0.0",
    "sharp": "^0.34.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lens.translate",
    "productName": "Lens Translate",
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["src/foreground.ps1", "src/drag-listener.ps1", "node_modules/sharp/**/*", "node_modules/@img/**/*", "node_modules/tesseract.js/**/*", "node_modules/tesseract.js-core/**/*"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
